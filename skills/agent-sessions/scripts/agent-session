#!/usr/bin/env python3
"""agent-session: run claude, codex or gemini as detached child agent sessions.

This file is the only path users call and the runner entry (`_run`); the code
lives in the agent_sessions package next to it (see its __init__ for the
module map). Every public name is re-exported here so the file can also be
imported as one module. Python 3.8+, standard library only.
"""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from agent_sessions import VERSION  # noqa: E402,F401
from agent_sessions.common import *  # noqa: E402,F401,F403
from agent_sessions.procs import *  # noqa: E402,F401,F403
from agent_sessions.backend import *  # noqa: E402,F401,F403
from agent_sessions.state import *  # noqa: E402,F401,F403
from agent_sessions.schema import *  # noqa: E402,F401,F403
from agent_sessions.engines import *  # noqa: E402,F401,F403
from agent_sessions.gitops import *  # noqa: E402,F401,F403
from agent_sessions.launch import *  # noqa: E402,F401,F403
from agent_sessions.runner import *  # noqa: E402,F401,F403
from agent_sessions.commands import *  # noqa: E402,F401,F403
from agent_sessions.review import *  # noqa: E402,F401,F403
from agent_sessions.plans import *  # noqa: E402,F401,F403
from agent_sessions.cli import COMMANDS, FLAGS, HELP, entry, main  # noqa: E402,F401

if __name__ == "__main__":
    entry()
