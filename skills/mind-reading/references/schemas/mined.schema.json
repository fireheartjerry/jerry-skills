{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "mind-reading mined chunk",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "traits",
  "unsaid_defaults",
  "seed_expansions",
  "reactions",
  "vocabulary",
  "preference_changes",
  "session_stats"
 ],
 "properties": {
  "traits": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "layer",
     "claim",
     "scope",
     "strength",
     "count",
     "evidence"
    ],
    "properties": {
     "layer": {
      "type": "string",
      "enum": [
       "thinking",
       "quality_bar",
       "building",
       "design_taste",
       "communication",
       "standing_rules",
       "likes",
       "dislikes",
       "workflow",
       "context"
      ]
     },
     "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "scope": {
      "type": "string",
      "enum": [
       "person",
       "project"
      ]
     },
     "strength": {
      "type": "string",
      "enum": [
       "strong",
       "moderate",
       "weak"
      ]
     },
     "count": {
      "type": "integer",
      "minimum": 1
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "quote",
        "time",
        "session",
        "origin"
       ],
       "properties": {
        "quote": {
         "type": "string",
         "minLength": 1,
         "maxLength": 200
        },
        "time": {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 40
        },
        "session": {
         "type": "string",
         "maxLength": 120
        },
        "origin": {
         "type": "string",
         "enum": [
          "typed",
          "drafted",
          "pasted",
          "question_answer",
          "goal_reminder"
         ]
        },
        "source": {
         "type": "string",
         "maxLength": 300
        },
        "key": {
         "type": "string",
         "maxLength": 300
        },
        "source_id": {
         "type": "string",
         "maxLength": 300
        }
       }
      }
     },
     "evidence_class": {
      "type": "string",
      "enum": [
       "stated_rule",
       "correction",
       "inferred",
       "endorsed"
      ]
     },
     "hedge": {
      "type": "string",
      "maxLength": 200
     }
    }
   }
  },
  "unsaid_defaults": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "when",
     "default",
     "scope",
     "evidence"
    ],
    "properties": {
     "when": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "default": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
     },
     "kind": {
      "type": "string",
      "enum": [
       "default",
       "constraint",
       "scope",
       "follow_through",
       "reporting",
       "preference"
      ]
     },
     "scope": {
      "type": "string",
      "enum": [
       "person",
       "project"
      ]
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "first",
        "later",
        "time",
        "session"
       ],
       "properties": {
        "first": {
         "type": "string",
         "maxLength": 200
        },
        "later": {
         "type": "string",
         "maxLength": 200
        },
        "time": {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 40
        },
        "session": {
         "type": "string",
         "maxLength": 120
        },
        "source": {
         "type": "string",
         "maxLength": 300
        },
        "key": {
         "type": "string",
         "maxLength": 300
        },
        "source_id": {
         "type": "string",
         "maxLength": 300
        },
        "first_source": {
         "type": "string",
         "maxLength": 300
        },
        "first_session": {
         "type": "string",
         "maxLength": 300
        },
        "first_key": {
         "type": "string",
         "maxLength": 300
        },
        "first_source_id": {
         "type": "string",
         "maxLength": 300
        },
        "first_time": {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 40
        },
        "later_source": {
         "type": "string",
         "maxLength": 300
        },
        "later_session": {
         "type": "string",
         "maxLength": 300
        },
        "later_key": {
         "type": "string",
         "maxLength": 300
        },
        "later_source_id": {
         "type": "string",
         "maxLength": 300
        },
        "later_time": {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 40
        }
       }
      }
     },
     "evidence_class": {
      "type": "string",
      "enum": [
       "stated_rule",
       "correction",
       "inferred",
       "endorsed"
      ]
     },
     "hedge": {
      "type": "string",
      "maxLength": 200
     }
    }
   }
  },
  "seed_expansions": {
   "type": "array",
   "maxItems": 12,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "seed",
     "context",
     "full_prompt",
     "tags"
    ],
    "properties": {
     "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
     },
     "context": {
      "type": "string",
      "maxLength": 160
     },
     "full_prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
     },
     "tags": {
      "type": "array",
      "maxItems": 4,
      "items": {
       "type": "string",
       "maxLength": 40
      }
     },
     "source": {
      "type": "string",
      "maxLength": 300
     },
     "key": {
      "type": "string",
      "maxLength": 300
     },
     "source_id": {
      "type": "string",
      "maxLength": 300
     },
     "session": {
      "type": "string",
      "maxLength": 120
     }
    }
   }
  },
  "reactions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "quote",
     "about",
     "time",
     "session"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "praise",
       "frustration",
       "correction"
      ]
     },
     "quote": {
      "type": "string",
      "maxLength": 200
     },
     "about": {
      "type": "string",
      "maxLength": 160
     },
     "time": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 40
     },
     "session": {
      "type": "string",
      "maxLength": 120
     },
     "source": {
      "type": "string",
      "maxLength": 300
     },
     "key": {
      "type": "string",
      "maxLength": 300
     },
     "source_id": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "vocabulary": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "phrase",
     "meaning"
    ],
    "properties": {
     "phrase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "meaning": {
      "type": "string",
      "maxLength": 200
     }
    }
   }
  },
  "preference_changes": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "topic",
     "earlier",
     "later",
     "earlier_time",
     "later_time",
     "session"
    ],
    "properties": {
     "topic": {
      "type": "string",
      "maxLength": 80
     },
     "earlier": {
      "type": "string",
      "maxLength": 200
     },
     "later": {
      "type": "string",
      "maxLength": 200
     },
     "earlier_time": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 40
     },
     "later_time": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 40
     },
     "session": {
      "type": "string",
      "maxLength": 120
     },
     "source": {
      "type": "string",
      "maxLength": 300
     },
     "key": {
      "type": "string",
      "maxLength": 300
     },
     "source_id": {
      "type": "string",
      "maxLength": 300
     },
     "earlier_source": {
      "type": "string",
      "maxLength": 300
     },
     "earlier_session": {
      "type": "string",
      "maxLength": 300
     },
     "earlier_key": {
      "type": "string",
      "maxLength": 300
     },
     "earlier_source_id": {
      "type": "string",
      "maxLength": 300
     },
     "later_source": {
      "type": "string",
      "maxLength": 300
     },
     "later_session": {
      "type": "string",
      "maxLength": 300
     },
     "later_key": {
      "type": "string",
      "maxLength": 300
     },
     "later_source_id": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "grants": {
   "type": "array",
   "maxItems": 20,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "quote",
     "time",
     "session",
     "origin",
     "scope",
     "covers"
    ],
    "properties": {
     "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "time": {
      "type": [
       "string",
       "null"
      ],
      "maxLength": 40
     },
     "session": {
      "type": "string",
      "maxLength": 120
     },
     "origin": {
      "type": "string",
      "enum": [
       "typed",
       "drafted",
       "pasted",
       "question_answer",
       "goal_reminder"
      ]
     },
     "scope": {
      "type": "string",
      "maxLength": 120
     },
     "covers": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "source": {
      "type": "string",
      "maxLength": 300
     },
     "key": {
      "type": "string",
      "maxLength": 300
     },
     "source_id": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "lessons": {
   "type": "array",
   "maxItems": 30,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "request_kind",
     "situation",
     "pattern",
     "outcome",
     "outcome_detail",
     "better_alternative",
     "signals",
     "cost",
     "scope",
     "strength",
     "count",
     "adopted",
     "evidence"
    ],
    "properties": {
     "request_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "situation": {
      "type": "string",
      "maxLength": 200
     },
     "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
     },
     "outcome": {
      "type": "string",
      "enum": [
       "bad",
       "good"
      ]
     },
     "outcome_detail": {
      "type": "string",
      "maxLength": 240
     },
     "better_alternative": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
     },
     "signals": {
      "type": "array",
      "maxItems": 6,
      "items": {
       "type": "string",
       "enum": [
        "rework",
        "repeated_failure",
        "correction",
        "wasted_time",
        "wasted_money",
        "reverted",
        "frustration",
        "praise",
        "reuse"
       ]
      }
     },
     "cost": {
      "type": "string",
      "enum": [
       "low",
       "medium",
       "high"
      ]
     },
     "scope": {
      "type": "string",
      "enum": [
       "person",
       "project"
      ]
     },
     "strength": {
      "type": "string",
      "enum": [
       "strong",
       "moderate",
       "weak"
      ]
     },
     "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
     },
     "adopted": {
      "type": "string",
      "enum": [
       "yes",
       "no",
       "unclear"
      ]
     },
     "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "quote",
        "time",
        "session",
        "origin",
        "role"
       ],
       "properties": {
        "quote": {
         "type": "string",
         "minLength": 1,
         "maxLength": 200
        },
        "time": {
         "type": [
          "string",
          "null"
         ],
         "maxLength": 40
        },
        "session": {
         "type": "string",
         "maxLength": 120
        },
        "origin": {
         "type": "string",
         "enum": [
          "typed",
          "drafted",
          "pasted",
          "question_answer",
          "goal_reminder",
          "agent_context"
         ]
        },
        "role": {
         "type": "string",
         "enum": [
          "user",
          "agent_context"
         ]
        },
        "source": {
         "type": "string",
         "maxLength": 300
        },
        "key": {
         "type": "string",
         "maxLength": 300
        },
        "source_id": {
         "type": "string",
         "maxLength": 300
        }
       }
      }
     },
     "evidence_class": {
      "type": "string",
      "enum": [
       "stated_rule",
       "correction",
       "inferred",
       "endorsed"
      ]
     },
     "hedge": {
      "type": "string",
      "maxLength": 200
     }
    }
   }
  },
  "session_stats": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sessions_read",
    "messages_read",
    "time_reliable_sessions"
   ],
   "properties": {
    "sessions_read": {
     "type": "integer",
     "minimum": 0
    },
    "messages_read": {
     "type": "integer",
     "minimum": 0
    },
    "time_reliable_sessions": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 }
}
