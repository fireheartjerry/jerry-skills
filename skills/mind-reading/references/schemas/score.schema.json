{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "mind-reading eval score",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "items",
  "contradictions",
  "upgrades",
  "wrong_upgrades"
 ],
 "properties": {
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "verdict"
    ],
    "properties": {
     "id": {
      "type": "integer",
      "minimum": 1
     },
     "verdict": {
      "type": "string",
      "enum": [
       "full",
       "partial",
       "none"
      ]
     }
    }
   }
  },
  "contradictions": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "requirement_id"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 200
     },
     "requirement_id": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   }
  },
  "upgrades": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "requirement_id"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 200
     },
     "requirement_id": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   }
  },
  "wrong_upgrades": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "requirement_id"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 200
     },
     "requirement_id": {
      "type": [
       "integer",
       "null"
      ]
     }
    }
   }
  }
 }
}
