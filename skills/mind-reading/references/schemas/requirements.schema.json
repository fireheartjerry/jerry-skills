{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "mind-reading eval requirements",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "requirements"
 ],
 "properties": {
  "requirements": {
   "type": "array",
   "minItems": 1,
   "maxItems": 30,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "text",
     "kind"
    ],
    "properties": {
     "id": {
      "type": "integer",
      "minimum": 1
     },
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
     },
     "kind": {
      "type": "string",
      "enum": [
       "goal",
       "scope",
       "quality",
       "deliverable",
       "follow_through",
       "reporting",
       "preference",
       "constraint",
       "task_fact"
      ]
     }
    }
   }
  }
 }
}
